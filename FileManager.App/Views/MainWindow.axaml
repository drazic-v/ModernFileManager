<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileManager.App.ViewModels"
        xmlns:conv="using:FileManager.App.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="576"
        x:Class="FileManager.App.Views.MainWindow"
        x:DataType="vm:WorkspaceViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="FileManager.App"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <conv:BytesToSizeConverter x:Key="BytesToSizeConverter"/>
        <conv:ItemKindVisibilityConverter x:Key="ItemKindVisibility"/>
    </Window.Resources>

    <Grid ColumnDefinitions="220,*, Auto">
        <Border Grid.Column="0">
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto, Auto, *" Background="{DynamicResource SurfaceBackgroundBrush}">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Background="{DynamicResource SurfaceBackgroundBrush}">
                <ListBox ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding SelectedTab}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,4">
                                <TextBlock Text="{Binding TabName}"/>
                                <Button Content="✕"
                                Command="{Binding $parent[Window].DataContext.CloseTabCommand}"
                                CommandParameter="{Binding}"
                                IsVisible="{Binding $parent[Window].DataContext.CanCloseTabs}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="+" Command="{Binding AddTabCommand}"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Grid.Row="1">
                <Button Content="←" Command="{Binding SelectedTab.BackCommand}" />
                <Button Content="→" Command="{Binding SelectedTab.ForwardCommand}" />
                <Button Content="↑" Command="{Binding SelectedTab.NavigateUpCommand}" />
                <Button Content="↻" Command="{Binding SelectedTab.RefreshCommand}" />
                <CheckBox Content="Show hidden" IsChecked="{Binding SelectedTab.ShowHiddenItems}"/>
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="6"
                        Padding="10,4"
                        Margin="8,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedTab.CurrentFolder}"/>
                </Border>
                <TextBox PlaceholderText="Search this folder..." Text="{Binding SelectedTab.SearchText}" Width="180" KeyDown="OnSearchKeyDown"/>
                <Button Content="✕" Command="{Binding SelectedTab.ClearSearchCommand}" IsVisible="{Binding SelectedTab.IsSearchActive}"/>
            </StackPanel>

            <DataGrid Grid.Row="2" Background="{DynamicResource SurfaceBackgroundBrush}"
                 ItemsSource="{Binding SelectedTab.Items}"
                 SelectedItem="{Binding SelectedTab.SelectedItem}"
                 DoubleTapped="OnItemDoubleTapped"
                 AutoGenerateColumns="False"
                 IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="300"/>
                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="100"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeInBytes}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Column="2"
           Background="{DynamicResource SurfaceBackgroundBrush}"
           Padding="14"
           Width="240">
           <StackPanel Spacing="8">
                <TextBlock Text="{Binding SelectedTab.SelectedItem.Name, FallbackValue='No item selected'}"
                           FontWeight="Bold" TextWrapping="Wrap"/>

                <StackPanel Spacing="8"
                            IsVisible="{Binding SelectedTab.SelectedItem, Converter={StaticResource ItemKindVisibility}, ConverterParameter=File}">
                    <TextBlock Text="{Binding SelectedTab.SelectedItem.Kind, StringFormat='Kind: {0}'}"/>
                    <TextBlock Text="{Binding SelectedTab.SelectedItem.SizeInBytes, Converter={StaticResource BytesToSizeConverter}, StringFormat='Size: {0}'}"/>
                    <TextBlock Text="{Binding SelectedTab.SelectedItem.LastModifiedUtc, StringFormat='Modified: {0:g}'}"/>
                </StackPanel>

                <StackPanel Spacing="8"
                            IsVisible="{Binding SelectedTab.SelectedItem, Converter={StaticResource ItemKindVisibility}, ConverterParameter=Directory}">
                    <TextBlock Text="Calculating..." IsVisible="{Binding SelectedTab.IsFolderInfoLoading}"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding SelectedTab.FolderSizeInBytes, Converter={StaticResource BytesToSizeConverter}, StringFormat='Total size: {0}'}"/>
                    <TextBlock Text="{Binding SelectedTab.FolderFileCount, StringFormat='Files: {0}'}"/>
                    <TextBlock Text="{Binding SelectedTab.FolderFolderCount, StringFormat='Folders: {0}'}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

</Window>
