<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileManager.App.ViewModels"
        xmlns:conv="using:FileManager.App.Converters"
        xmlns:objconv="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="576"
        x:Class="FileManager.App.Views.MainWindow"
        x:DataType="vm:WorkspaceViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="FileManager.App"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <conv:BytesToSizeConverter x:Key="BytesToSizeConverter"/>
        <conv:ItemKindVisibilityConverter x:Key="ItemKindVisibility"/>
        <conv:BoolToWidthConverter x:Key="BoolToWidthConverter"/>
        <conv:GreaterThanZeroConverter x:Key="GreaterThanZero"/>
    </Window.Resources>

    <Grid ColumnDefinitions="220,*, Auto">
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBackgroundBrush}" Padding="12">
            <StackPanel Spacing="6">
                <TextBlock Text="PROVIDERS" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>

                <ItemsControl ItemsSource="{Binding Providers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding DisplayName}"
                                    Command="{Binding $parent[Window].DataContext.OpenProviderCommand}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="+ Add Provider" Command="{Binding AddProviderCommand}" 
                        IsEnabled="False"
                        ToolTip.Tip="Cloud providers aren't wired up yet"   
                        HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto, Auto, *, Auto, Auto" Background="{DynamicResource SurfaceBackgroundBrush}">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Background="{DynamicResource SurfaceBackgroundBrush}">
                <ListBox ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding SelectedTab}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,4">
                                <TextBlock Text="{Binding TabName}"/>
                                <Button Content="✕"
                                Command="{Binding $parent[Window].DataContext.CloseTabCommand}"
                                CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="+" Command="{Binding AddTabCommand}"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Grid.Row="1" 
                        IsVisible="{Binding SelectedTab, Converter={x:Static objconv:ObjectConverters.IsNotNull}}"
                        Spacing="4">
                <Button Content="←" Command="{Binding SelectedTab.BackCommand}" />
                <Button Content="→" Command="{Binding SelectedTab.ForwardCommand}" />
                <Button Content="↑" Command="{Binding SelectedTab.NavigateUpCommand}" />
                <Button Content="↻" Command="{Binding SelectedTab.RefreshCommand}" />
                <CheckBox Content="Show hidden" IsChecked="{Binding SelectedTab.ShowHiddenItems}"/>
                <ToggleButton Content="Details" IsChecked="{Binding SelectedTab.IsDetailsPanelOpen}"/>
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="6"
                        Padding="10,4"
                        Margin="8,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedTab.CurrentFolder}"/>
                </Border>
                <TextBox PlaceholderText="Search this folder..." Text="{Binding SelectedTab.SearchText}" Width="180" KeyDown="OnSearchKeyDown"/>
                <Button Content="✕" Command="{Binding SelectedTab.ClearSearchCommand}" IsVisible="{Binding SelectedTab.IsSearchActive}"/>
            </StackPanel>

            <Grid Grid.Row="2">
                <ItemsControl ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DataGrid Background="{DynamicResource SurfaceBackgroundBrush}"
                                      ItemsSource="{Binding Items}"
                                      SelectedItem="{Binding SelectedItem}"
                                      IsVisible="{Binding IsActive}"
                                      DoubleTapped="OnItemDoubleTapped"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="300"/>
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="100"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeInBytes}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>


                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                           IsVisible="{Binding SelectedTab, Converter={x:Static objconv:ObjectConverters.IsNull}}">
                   <TextBlock Text="No tabs open" FontSize="16" HorizontalAlignment="Center"
                              Foreground="{DynamicResource TextSecondaryBrush}"/>
                   <TextBlock Text="Click + above to open a new tab, or pick a provider from the sidebar"
                              HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
               </StackPanel>
            </Grid>

            <Border Grid.Row="3" Padding="8,4"
                    Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderLightBrush}"
                    BorderThickness="0,1,0,0"
                    IsVisible="{Binding ActiveTransfers.Count, Converter={StaticResource GreaterThanZero}}">
                <ItemsControl ItemsSource="{Binding ActiveTransfers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                <TextBlock Text="{Binding Name}" Width="200"/>
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Width="150"/>
                                <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0:0}%'}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Grid.Row="4" Padding="8,4"
                    Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderLightBrush}"
                    BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding Tabs.Count, StringFormat='{}{0} tab(s) open'}"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
            </Border>

        </Grid>

        <Border Grid.Column="2"
           Background="{DynamicResource SurfaceBackgroundBrush}"
           ClipToBounds="True"
           Width="{Binding SelectedTab.IsDetailsPanelOpen, Converter={StaticResource BoolToWidthConverter}, FallbackValue=0}">
           <Border.Transitions>
               <Transitions>
                   <DoubleTransition Property="Width" Duration="0:0:0.18"/>
               </Transitions>
           </Border.Transitions>
           <StackPanel Spacing="8" IsVisible="{Binding SelectedTab, Converter={x:Static objconv:ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding SelectedTab.SelectedItem.Name, FallbackValue='No item selected'}"
                           FontWeight="Bold" TextWrapping="Wrap"/>

                <StackPanel Spacing="8"
                            IsVisible="{Binding SelectedTab.SelectedItem, Converter={StaticResource ItemKindVisibility}, ConverterParameter=File}">
                    <TextBlock Text="{Binding SelectedTab.SelectedItem.Kind, StringFormat='Kind: {0}'}"/>
                    <TextBlock Text="{Binding SelectedTab.SelectedItem.SizeInBytes, Converter={StaticResource BytesToSizeConverter}, StringFormat='Size: {0}'}"/>
                    <TextBlock Text="{Binding SelectedTab.SelectedItem.LastModifiedUtc, StringFormat='Modified: {0:g}'}"/>
                </StackPanel>

                <StackPanel Spacing="8"
                            IsVisible="{Binding SelectedTab.SelectedItem, Converter={StaticResource ItemKindVisibility}, ConverterParameter=Directory}">
                    <TextBlock Text="Calculating..." IsVisible="{Binding SelectedTab.IsFolderInfoLoading}"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding SelectedTab.FolderSizeInBytes, Converter={StaticResource BytesToSizeConverter}, StringFormat='Total size: {0}'}"/>
                    <TextBlock Text="{Binding SelectedTab.FolderFileCount, StringFormat='Files: {0}'}"/>
                    <TextBlock Text="{Binding SelectedTab.FolderFolderCount, StringFormat='Folders: {0}'}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

</Window>
